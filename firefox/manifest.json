{
  "manifest_version": 3,
  "name": "迷惑サイト除外",
  "version": "1.0.0",
  "description": "Google・Bingの検索結果から、ブラックリストに入れたサイトを表示しないようにします。",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "迷惑サイト除外（除外リスト）",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.co.jp/search*",
        "https://www.bing.com/search*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "meiwaku-site-jogai@hakusyaku-lab",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
